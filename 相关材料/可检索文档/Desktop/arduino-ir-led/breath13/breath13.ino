/* ============================================================================
 *  breath13 —— 橘红色呼吸灯
 *  ---------------------------------------------------------------------------
 *  用 for 循环把亮度从 0 推到 255，再推回 0，做出"慢慢亮、慢慢暗"的呼吸感。
 *  接线和 blink13 完全一样（RGB LED）：R->D9  G->D10  B->D11  公共脚->GND
 *
 *  板子: Arduino UNO / Nano
 *  日期: 2026-10-16
 *
 *  【呼吸一次要多久】
 *    渐亮步数 = 255 / STEP，单程时间 = 步数 x STEP_MS
 *    STEP=5, STEP_MS=15 时：51 步 x 15ms ≈ 765ms，一个完整来回约 1.5 秒
 * ==========================================================================*/

/* ---------------- 接法：0 = 共阴(公共脚接 GND)，1 = 共阳(公共脚接 5V) ------ */
#define COMMON_ANODE 0

/* ---------------- 三个颜色脚（必须都是 PWM 脚）---------------------------- */
const uint8_t PIN_R = 9;
const uint8_t PIN_G = 10;
const uint8_t PIN_B = 11;

/* ---------------- 橘红色配方 --------------------------------------------- */
const uint8_t ORANGE_R = 255;
const uint8_t ORANGE_G =  90;
const uint8_t ORANGE_B =   0;

/* ---------------- 呼吸节奏 ----------------------------------------------- */
const uint8_t  STEP    = 5;     // 每次亮度变化多少：1=最细腻但慢，15=快而有点跳
const uint16_t STEP_MS = 15;    // 每一步停多久（毫秒）

/* 伽马校正：改成 1 开启。人眼对亮度的感觉不是线性的，线性 PWM 渐变
   看起来会"前段变化明显、后段几乎看不出来"，开这个会让渐变顺眼很多。 */
#define GAMMA 0

/* =========================== 混色 ======================================== */
void setColor(uint8_t r, uint8_t g, uint8_t b) {
#if COMMON_ANODE
  analogWrite(PIN_R, 255 - r);
  analogWrite(PIN_G, 255 - g);
  analogWrite(PIN_B, 255 - b);
#else
  analogWrite(PIN_R, r);
  analogWrite(PIN_G, g);
  analogWrite(PIN_B, b);
#endif
}

/* =========================== 按"进度"点亮 ================================ */
/* level: 0 = 全灭, 255 = 橘红最亮。中间值就是按比例压暗的橘红。 */
void showLevel(uint8_t level) {
#if GAMMA
  /* 平方曲线做伽马校正。用 uint32_t 算，255*255=65025，
     绝不能让它按 16 位 int 去乘（会溢出成负数）。 */
  uint8_t L = (uint8_t)((uint32_t)level * level / 255UL);
#else
  uint8_t L = level;
#endif
  /* map() 内部是 32 位 long 运算，所以这里不会溢出 */
  setColor(map(L, 0, 255, 0, ORANGE_R),
           map(L, 0, 255, 0, ORANGE_G),
           map(L, 0, 255, 0, ORANGE_B));
}

/* =========================== 初始化 ====================================== */
void setup() {
  pinMode(PIN_R, OUTPUT);
  pinMode(PIN_G, OUTPUT);
  pinMode(PIN_B, OUTPUT);
  showLevel(0);                 // 上电先灭
}

/* =========================== 主循环：一呼一吸 ============================ */
void loop() {
  /* 渐亮：0 -> 255 */
  for (int i = 0; i <= 255; i += STEP) {
    showLevel((uint8_t)i);
    delay(STEP_MS);
  }

  /* 渐暗：255 -> 0 */
  for (int i = 255; i >= 0; i -= STEP) {
    showLevel((uint8_t)i);
    delay(STEP_MS);
  }

  /* 想让它"吸一口、停一下再呼"，在两个循环中间加一句 delay(300) 即可 */
}

/* ----------------------------------------------------------------------------
 *  【为什么不写成 ORANGE_R * i / 255 】
 *    UNO 的 int 是 16 位，最大 32767。255 * 129 = 32895 直接溢出，
 *    结果变成负数，转成 uint8_t 后是 134 这种乱值 —— 亮度不再平滑上升，
 *    而是抖动。map() 用 32 位 long，所以安全；或者自己写
 *    (uint8_t)((uint32_t)ORANGE_R * i / 255) 也行。
 *
 *  【想让灯边呼吸边干别的】
 *    上面用 delay() 会把板子卡住。要同时读传感器，就把 for 循环拆成
 *    每毫秒推进一格的状态机（pet_sense 里就是那种写法）。
 * --------------------------------------------------------------------------*/
